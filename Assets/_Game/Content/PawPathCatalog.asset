  m_Name: 
  m_EditorClassIdentifier: 
  id: tarcin
  displayName: "Tar\xE7\u0131n"
  bio: "\xDC\xE7 renkli, \xFC\xE7 kat merakl\u0131. T\xFCy oltay\u0131 g\xF6r\xFCnce
    d\xFCnya durur."
  encounterDialogue: "Tar\xE7\u0131n, d\xFC\u015Fen yapraklar\u0131n aras\u0131nda
    z\u0131playa z\u0131playa sana geliyor. 'Bu yol biraz e\u011Flenceliydi,' der
    gibi m\u0131r\u0131ldan\u0131yor. Kap\u0131y\u0131 a\xE7\u0131k b\u0131rak\u0131yoruz."
  personality: 4
  unlockAfterLevel: 15
  furTint: {r: 0.9, g: 0.55, b: 0.32, a: 1}
